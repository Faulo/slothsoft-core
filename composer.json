{
    "name": "slothsoft/core",
    "description": "Core stuff.",
    "license": "MIT",
    "authors": [
        {
            "name": "Daniel Schulz",
            "email": "info.slothsoft@gmail.com"
        }
    ],
    "type": "library",
    "require": {
        "php": ">=7.4",
        "ext-dom": "*",
        "ext-libxml": "*",
        "ext-xsl": "*",
        "ext-curl": "*",
        "ext-mbstring": "*",
        "ext-json": "*",
        "ext-zlib": "*",
        "ext-fileinfo": "*",
        "php-ds/php-ds": "^1.7.0",
        "slothsoft/w3c": "^1.3.0",
        "psr/http-message": "^1.1",
        "guzzlehttp/psr7": "^2.13.1",
        "symfony/process": "^5.4.51"
    },
    "require-dev": {
        "ext-gd": "*",
        "ext-imagick": "*",
        "ext-mysqli": "*",
        "phpunit/phpunit": "~9.6.34"
    },
    "suggest": {
        "ext-mysqli": "Needed for databasing",
        "ext-curl": "Needed for networking",
        "ext-com_dotnet": "Needed for when FileSystem processes files >2GB under Windows",
        "ext-imagick": "Needed for ImageHelper",
        "ext-gd": "Needed for ImageHelper"
    },
    "autoload": {
        "files": [
            "scripts/bootstrap.php"
        ],
        "psr-4": {
            "Slothsoft\\Core\\": "src"
        }
    },
    "keywords": [
        "slothsoft",
        "docs"
    ],
    "bin": [
        "scripts/server-clean"
    ],
    "autoload-dev": {
        "psr-4": {
            "Slothsoft\\Core\\": "tests"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "1.14.x-dev"
        }
    },
    "homepage": "https://faulo.github.io/slothsoft-core/",
    "config": {
        "platform": {
            "php": "7.4"
        }
    }
}
